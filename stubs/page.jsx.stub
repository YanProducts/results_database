import use{{PageName}}Definitions from "{{BasePath}}Definition/{{Directories}}/use{{PageName}}Definitions";
import use{{PageName}}Actions from "{{BasePath}}Action/{{Directories}}/use{{PageName}}Actions";

export default function {{PageName}}({ prefix, what, type }) {

    // 定義セット
    const {data, setData, post, processing, errors,clearErrors, reset,validationHidden,setValidationHidden,pageMinWidth,pageMaxWidth} = use{{PageName}}Definitions({});

    // 動き
    const {} = use{{PageName}}Actions({data,setData,post,errors,setValidationHidden});

